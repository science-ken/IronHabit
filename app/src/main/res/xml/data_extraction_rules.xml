<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+（API 31+）数据提取规则：
  允许云备份与设备间迁移包含本地数据库与 DataStore，实现换机不丢数据。
  Android 11 及以下的对应规则见 backup_rules.xml。
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Room 数据库（唯一真源） -->
        <include domain="database" path="." />
        <!-- DataStore 设置 -->
        <include domain="file" path="datastore" />
        <!-- SharedPreferences（如有） -->
        <include domain="sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
