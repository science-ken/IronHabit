<?xml version="1.0" encoding="utf-8"?>
<!--
  IronHabit 基础色值（供启动图、通知小图标等 XML 场景使用）。
  说明：Compose 界面的配色走 M3 colorScheme（见 ui/theme/Color.kt），不在此处硬编码。
  2026-09-19 配色改版：品牌橙全部退场，启动图与图标跟着主色走深青 + 白底。
-->
<resources>
    <!-- 启动图标背景（白底，衬托深青哑铃） -->
    <color name="ic_launcher_background">#FFFFFFFF</color>

    <!-- 启动图窗口底色（与 Compose 的 surface 一致，避免开屏闪一下深色） -->
    <color name="splash_background">#FFFFFFFF</color>

    <!-- 通用黑白 -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- 通知小图标色（单色，系统按通知样式染色） -->
    <color name="notification_icon_color">#FFFFFFFF</color>
</resources>
