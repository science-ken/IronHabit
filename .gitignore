# =============================================================================
# IronHabit — Git 忽略规则
# =============================================================================
*.iml
.gradle/
/local.properties
/keystore.properties
*.jks
*.keystore
.idea/
.DS_Store
build/
/app/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.hprof

# Gradle Wrapper 的 jar 必须纳入版本管理，切勿忽略
!gradle/wrapper/gradle-wrapper.jar

# Kotlin 编译错误日志（构建产物）
.kotlin/

# 本地方案与原型（含截图，二进制进历史难清除）
.scratch/
# 若想把 spec 纳入版本库、只挡图片，改用下面两行代替上面一行：
# .scratch/**/*.png
# !.scratch/**/*.md
